#!/usr/bin/env python3
"""Install or verify Turbofit's SHA-pinned native inference runtimes."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "references/native-runtimes.json"


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(8 * 1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def run(command: list[str], *, cwd: Path | None = None) -> None:
    subprocess.run(command, cwd=cwd, check=True)


def cmake_configuration(backend: str) -> tuple[str, str]:
    try:
        return {
            "cuda": ("build-cuda", "-DGGML_CUDA=ON"),
            "rocm": ("build-rocm", "-DGGML_HIP=ON"),
            "metal": ("build-metal", "-DGGML_METAL=ON"),
            "vulkan": ("build-vulkan", "-DGGML_VULKAN=ON"),
            "cpu": ("build-cpu", "-DGGML_NATIVE=ON"),
        }[backend]
    except KeyError as exc:
        raise ValueError(f"unsupported native backend: {backend}") from exc


def native_server_binary(source: Path, build_dir: str) -> Path:
    root = source / build_dir / "bin"
    if os.name == "nt":
        return root / "Release" / "llama-server.exe"
    return root / "llama-server"


def detect_backend() -> str:
    explicit = os.getenv("TURBOFIT_ACCELERATOR_BACKEND", "").lower()
    if explicit:
        cmake_configuration(explicit)
        return explicit
    if sys.platform == "darwin":
        return "metal"
    if shutil.which("nvidia-smi"):
        return "cuda"
    if shutil.which("rocm-smi") or shutil.which("amd-smi") or shutil.which("rocminfo"):
        return "rocm"
    if shutil.which("vulkaninfo"):
        return "vulkan"
    return "cpu"


def install(runtime: dict, *, backend: str, check_only: bool) -> dict:
    cuda_binary = Path(os.path.expanduser(runtime["cuda_binary"])).resolve()
    source = Path(os.path.expanduser(runtime.get("source", str(cuda_binary.parents[2])))).resolve()
    build_dir, accelerator_flag = cmake_configuration(backend)
    binary = native_server_binary(source, build_dir)
    revision = runtime["revision"]
    if not source.exists():
        if check_only:
            raise FileNotFoundError(source)
        source.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", runtime["repository"], str(source)])
    actual = subprocess.check_output(["git", "-C", str(source), "rev-parse", "HEAD"], text=True).strip()
    if actual != revision:
        if check_only:
            raise RuntimeError(f"{runtime['id']} revision mismatch: {actual} != {revision}")
        run(["git", "-C", str(source), "fetch", "origin", revision])
        run(["git", "-C", str(source), "checkout", "--detach", revision])
    if not check_only:
        run([
            "cmake", "-B", build_dir, accelerator_flag, "-DLLAMA_CURL=OFF",
            "-DCMAKE_BUILD_TYPE=Release",
        ], cwd=source)
        run(["cmake", "--build", build_dir, "--target", "llama-server", "-j", str(os.cpu_count() or 8)], cwd=source)
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise RuntimeError(f"runtime binary is unavailable: {binary}")
    return {
        "id": runtime["id"],
        "backend": backend,
        "revision": revision,
        "binary": str(binary),
        "binary_sha256": sha256(binary),
        "status": "verified",
    }


def select_native_runtimes(runtimes: list[dict], selected: set[str]) -> list[dict]:
    native = [item for item in runtimes if item.get("kind", "cmake-llama.cpp") != "python-cli"]
    default_native = [item for item in native if not str(item.get("status", "")).startswith("candidate")]
    if "freetoken" in selected:
        raise ValueError("FreeToken uses scripts/install-freetoken-runtime, not install-native-runtimes")
    rows = [item for item in native if item["id"] in selected] if selected else default_native
    missing = selected - {item["id"] for item in rows}
    if missing:
        raise ValueError(f"unknown native runtime ids: {sorted(missing)}")
    return rows


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--runtime", action="append", help="runtime id; repeat to select several")
    parser.add_argument("--backend", choices=("cuda", "rocm", "metal", "vulkan", "cpu"))
    parser.add_argument("--check-only", action="store_true")
    args = parser.parse_args()
    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    selected = set(args.runtime or [])
    runtimes = select_native_runtimes(manifest["runtimes"], selected)
    backend = args.backend or detect_backend()
    records = [install(item, backend=backend, check_only=args.check_only) for item in runtimes]
    print(json.dumps({"schema": "turbofit.native-runtime-verification/v1", "runtimes": records}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
