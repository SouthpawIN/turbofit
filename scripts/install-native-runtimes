#!/usr/bin/env python3
"""Install or verify Turbofit's SHA-pinned native inference runtimes."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "references/native-runtimes.json"


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(8 * 1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def run(command: list[str], *, cwd: Path | None = None) -> None:
    subprocess.run(command, cwd=cwd, check=True)


def install(runtime: dict, *, check_only: bool) -> dict:
    binary = Path(os.path.expanduser(runtime["cuda_binary"])).resolve()
    source = Path(os.path.expanduser(runtime.get("source", str(binary.parents[2])))).resolve()
    revision = runtime["revision"]
    if not source.exists():
        if check_only:
            raise FileNotFoundError(source)
        source.parent.mkdir(parents=True, exist_ok=True)
        run(["git", "clone", runtime["repository"], str(source)])
    actual = subprocess.check_output(["git", "-C", str(source), "rev-parse", "HEAD"], text=True).strip()
    if actual != revision:
        if check_only:
            raise RuntimeError(f"{runtime['id']} revision mismatch: {actual} != {revision}")
        run(["git", "-C", str(source), "fetch", "origin", revision])
        run(["git", "-C", str(source), "checkout", "--detach", revision])
    if not check_only:
        run([
            "cmake", "-B", "build-cuda", "-DGGML_CUDA=ON", "-DLLAMA_CURL=OFF",
            "-DCMAKE_BUILD_TYPE=Release",
        ], cwd=source)
        run(["cmake", "--build", "build-cuda", "--target", "llama-server", "-j", str(os.cpu_count() or 8)], cwd=source)
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise RuntimeError(f"runtime binary is unavailable: {binary}")
    return {
        "id": runtime["id"],
        "revision": revision,
        "binary": str(binary),
        "binary_sha256": sha256(binary),
        "status": "verified",
    }


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--runtime", action="append", help="runtime id; repeat to select several")
    parser.add_argument("--check-only", action="store_true")
    args = parser.parse_args()
    manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    selected = set(args.runtime or [])
    runtimes = [item for item in manifest["runtimes"] if not selected or item["id"] in selected]
    missing = selected - {item["id"] for item in runtimes}
    if missing:
        raise ValueError(f"unknown runtime ids: {sorted(missing)}")
    records = [install(item, check_only=args.check_only) for item in runtimes]
    print(json.dumps({"schema": "turbofit.native-runtime-verification/v1", "runtimes": records}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
