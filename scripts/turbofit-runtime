#!/usr/bin/env python3
"""Configure Turbofit auto or manual adaptive selection safely."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src"
if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

# Prefer project venv when system python lacks deps or is too old (macOS ships 3.9).
if sys.version_info < (3, 10):
    _venv = ROOT / ".venv" / "bin" / "python"
    if _venv.is_file() and Path(sys.executable).resolve() != _venv.resolve():
        os.execv(str(_venv), [str(_venv), str(Path(__file__).resolve()), *sys.argv[1:]])
try:
    import yaml  # noqa: F401
except ImportError:
    _venv = ROOT / ".venv" / "bin" / "python"
    if _venv.is_file() and Path(sys.executable).resolve() != _venv.resolve():
        os.execv(str(_venv), [str(_venv), str(Path(__file__).resolve()), *sys.argv[1:]])

from turbofit_runtime.hardware import probe_hardware  # noqa: E402
from turbofit_runtime.runtime_cli import run  # noqa: E402
from turbofit_runtime.routes import load_runtime_resolutions_many  # noqa: E402
from turbofit_runtime.selection import ProfileCatalog  # noqa: E402

CONFIG_DIR = Path.home() / ".config" / "turbofit"


def profile_paths() -> tuple[Path, ...]:
    """Expose canonical Auto tiers plus the user's generated exact combination."""
    paths = list(sorted((ROOT / "runtime-profiles").glob("*gb.yaml")))
    manual = CONFIG_DIR / "manual-profile.yaml"
    if manual.is_file():
        paths.append(manual)
    return tuple(paths)


def main(argv: list[str]) -> int:
    selection_path = Path(
        os.getenv(
            "TURBOFIT_SELECTION_STATE",
            Path.home() / ".config" / "turbofit" / "selection.json",
        )
    )
    try:
        catalog = ProfileCatalog.from_paths(profile_paths())
        resolutions = load_runtime_resolutions_many((
            ROOT / "runtime-profiles/runtime-resolutions.json",
            CONFIG_DIR / "manual-runtime-resolutions.json",
        ))
        policy_path = ROOT / "references/catalog-campaign-policy.json"
        policy = json.loads(policy_path.read_text(encoding="utf-8")) if policy_path.is_file() else {}
        catalog = catalog.without_deferred_models(
            resolutions,
            {str(item) for item in policy.get("deferred_models", []) if isinstance(item, str)},
        )
        hardware = probe_hardware()
        return run(
            argv[1:],
            catalog=catalog,
            hardware=hardware,
            selection_path=selection_path,
            output=sys.stdout,
        )
    except Exception as exc:
        print(json.dumps({"error": str(exc)}, indent=2))
        return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
