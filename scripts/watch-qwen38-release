#!/usr/bin/env python3
"""Watch only the official Qwen Hugging Face organization for Qwen3.8-27B."""
from __future__ import annotations

import argparse
import json
import os
import tempfile
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

DEFAULT_STATE = Path.home() / ".local/state/turbofit/qwen38-release.json"
READY = Path.home() / ".local/state/turbofit/qwen38-release-ready"
STOP = Path.home() / ".local/state/turbofit/benchmark-orchestrator.stop"
POLICY = Path(__file__).resolve().parents[1] / "references/catalog-campaign-policy.json"
SEARCH = "Qwen3.8-27B"
API = "https://huggingface.co/api/models"


def atomic_json(path: Path, payload: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, indent=2, sort_keys=True)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def fetch(api_url: str = API) -> list[dict[str, Any]]:
    query = urllib.parse.urlencode({"author": "Qwen", "search": SEARCH, "limit": 100, "full": "true"})
    request = urllib.request.Request(f"{api_url}?{query}", headers={"User-Agent": "turbofit-qwen38-watch/1"})
    with urllib.request.urlopen(request, timeout=30) as response:
        payload = json.load(response)
    if not isinstance(payload, list):
        raise ValueError("Hugging Face model search returned a non-list payload")
    return [item for item in payload if isinstance(item, dict)]


def inspect(models: list[dict[str, Any]]) -> dict[str, Any]:
    official = []
    for item in models:
        model_id = str(item.get("id") or "")
        author = str(item.get("author") or model_id.partition("/")[0])
        revision = str(item.get("sha") or "")
        if author != "Qwen" or not model_id.startswith("Qwen/Qwen3.8-27B"):
            continue
        if item.get("private") or item.get("gated") not in (False, None) or len(revision) != 40:
            continue
        siblings = item.get("siblings") if isinstance(item.get("siblings"), list) else []
        files = sorted(
            str(sibling.get("rfilename"))
            for sibling in siblings
            if isinstance(sibling, dict) and sibling.get("rfilename")
        )
        official.append({
            "id": model_id,
            "revision": revision,
            "created_at": item.get("createdAt"),
            "last_modified": item.get("lastModified"),
            "pipeline_tag": item.get("pipeline_tag"),
            "files": files,
            "gguf_files": [name for name in files if name.lower().endswith(".gguf")],
        })
    official.sort(key=lambda item: item["id"])
    return {
        "schema": "turbofit.qwen38-release-watch/v1",
        "status": "official-release-detected" if official else "waiting-for-official-release",
        "official_models": official,
        "third_party_models_accepted": False,
        "next": (
            "build a pinned onboarding spec and verify exact artifacts"
            if official
            else "continue watching the official Qwen organization"
        ),
    }


def should_pause_campaign(result: dict[str, Any], replacement_status: str) -> bool:
    return (
        result.get("status") == "official-release-detected"
        and not replacement_status.startswith("onboarded-")
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--api-url", default=API)
    parser.add_argument("--state", type=Path, default=DEFAULT_STATE)
    args = parser.parse_args()
    result = inspect(fetch(args.api_url))
    policy = {}
    try:
        policy = json.loads(POLICY.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    replacement_status = str((policy.get("replacement") or {}).get("status") or "")
    already_onboarded = replacement_status.startswith("onboarded-")
    pause_requested = should_pause_campaign(result, replacement_status)
    if pause_requested:
        READY.parent.mkdir(parents=True, exist_ok=True)
        READY.touch()
        STOP.touch()
    result["campaign_pause_requested"] = pause_requested
    result["already_onboarded"] = already_onboarded
    stored = {**result, "checked_at": datetime.now(timezone.utc).isoformat()}
    atomic_json(args.state, stored)
    print(json.dumps(result, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
