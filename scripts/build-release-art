<g transform="translate(800 430)"><rect x="-54" y="-130" width="108" height="185" rx="52" fill="url(#dots)" stroke="{MINT}" stroke-width="5"/><path d="M-105 10V45A105 105 0 00105 45V10 M0 150V78 M-72 150H72" fill="none" stroke="{AMBER}" stroke-width="6"/></g>
<g transform="translate(1220 430)"><path d="M-125-75H-45L45-145V145L-45 75H-125Z" fill="url(#dots)" stroke="{AMBER}" stroke-width="5"/><path d="M85-90Q165 0 85 90 M125-130Q245 0 125 130" fill="none" stroke="{MINT}" stroke-width="7"/></g>'''
body=f'''{text(72,76,'TURBOFIT  //  MULTIMODAL MODEL MANAGER',22,MINT)}
