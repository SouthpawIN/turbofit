# 3: hardware ladder
rows=[('300+ GB','DEEPSEEK V4 FLASH 0731 Q4',300),('128–256 GB','DEEPSEEK V4 FLASH 0731 Q2 DSPARK',385),('24–128 GB','QWEN 3.8 27B  /  Q4 · Q8 · BF16',470),('16 GB','TERNARY BONSAI 27B',555),('8 GB','BINARY BONSAI 27B',640)]
parts=[]
for i,(tier,model,y) in enumerate(rows):
    parts.append(f'''<circle cx="450" cy="{y-8}" r="{10+i*2}" fill="{MINT}"/><path d="M470 {y-8}H620" stroke="{MINT}" stroke-width="{5-i*.5}"/><rect x="620" y="{y-48}" width="845" height="72" fill="{BG}" opacity=".82" stroke="{AMBER}"/><rect x="620" y="{y-48}" width="{90+i*55}" height="72" fill="url(#dots)"/>{text(95,y,tier,28,MINT)}{text(660,y,model,24,AMBER)}''')
body=f'''{text(72,76,'TURBOFIT 2.2  //  AUTO-FIT MODEL LADDER',22,MINT)}
{text(72,155,'ONE PROVIDER.',52,AMBER,'serif')}{text(72,215,'EVERY MACHINE.',52,AMBER,'serif')}
<path d="M450 280C520 340 385 415 450 470S385 585 450 640" fill="none" stroke="{MINT}" stroke-width="5" filter="url(#glow)"/>
{''.join(parts)}
<rect x="88" y="705" width="1377" height="86" fill="{BG}" opacity=".8" stroke="{MINT}"/>
{text(120,740,'AUXILIARY',17,MINT)}{text(120,770,'CARWIN NANO  /  TERNARY BONSAI  /  BINARY BONSAI  /  AUTO',18,CREAM)}
