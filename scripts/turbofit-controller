#!/usr/bin/env python3
"""Turbofit v2 adaptive controller daemon; Turbohaul is sole process authority."""
from __future__ import annotations

import argparse
import json
import os
import sys
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src"
if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

from turbofit_runtime.hardware import probe_hardware  # noqa: E402
from turbofit_runtime.pressure_probe import probe_nvidia_pressure  # noqa: E402
from turbofit_runtime.profile_io import load_profile  # noqa: E402
from turbofit_runtime.routes import load_runtime_resolutions  # noqa: E402
from turbofit_runtime.runtime_service import RuntimeService  # noqa: E402
from turbofit_runtime.selection import ProfileCatalog  # noqa: E402
from turbofit_runtime.turbohaul_backend import TurbohaulBackend  # noqa: E402
from turbofit_runtime.turbohaul_client import TurbohaulClient  # noqa: E402


def supported_profiles() -> tuple[Path, ...]:
    requirements = json.loads(
        (ROOT / "runtime-profiles" / "rung-requirements.json").read_text()
    )["profiles"]
    resolutions = json.loads(
        (ROOT / "runtime-profiles" / "runtime-resolutions.json").read_text()
    )["profiles"]
    api_only = {
        profile_id
        for profile_id, rows in requirements.items()
        if all(not row["required_mb_per_card"] for row in rows)
    }
    supported = set(resolutions) | api_only
    candidates = list((ROOT / "runtime-profiles").glob("*gb.yaml"))
    candidates.extend((ROOT / "runtime-profiles" / "migrated").glob("*.json"))
    return tuple(
        sorted(
            path
            for path in candidates
            if load_profile(path).id in supported
        )
    )


def build_runtime(args: argparse.Namespace, client: TurbohaulClient) -> RuntimeService:
    catalog = ProfileCatalog.from_paths(supported_profiles())
    resolutions = load_runtime_resolutions(
        ROOT / "runtime-profiles" / "runtime-resolutions.json"
    )

    def backend_factory(profile, state):
        return TurbohaulBackend(
            profile=profile,
            resolutions=resolutions,
            route_state_path=args.routes,
            manager_port=args.manager_port,
            client=client,
            current_state=state,
        )

    return RuntimeService(
        catalog=catalog,
        resolutions=resolutions,
        requirements_path=ROOT / "runtime-profiles" / "rung-requirements.json",
        controller_state_path=args.state,
        route_state_path=args.routes,
        manager_port=args.manager_port,
        backend_factory=backend_factory,
    )


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--once", action="store_true", help="run one bounded controller tick")
    parser.add_argument("--interval", type=float, default=2.0)
    parser.add_argument("--manager-url", default=os.getenv("TURBOHAUL_URL", "http://127.0.0.1:11401"))
    parser.add_argument("--manager-port", type=int, default=11401)
    parser.add_argument(
        "--selection",
        type=Path,
        default=Path(os.getenv("TURBOFIT_SELECTION_STATE", Path.home() / ".config/turbofit/selection.json")),
    )
    parser.add_argument(
        "--state",
        type=Path,
        default=Path(os.getenv("TURBOFIT_CONTROLLER_STATE", Path.home() / ".local/state/turbofit/controller.json")),
    )
    parser.add_argument(
        "--routes",
        type=Path,
        default=Path(os.getenv("TURBOFIT_RUNTIME_STATE", Path.home() / ".local/state/turbofit/runtime-state.json")),
    )
    args = parser.parse_args(argv)
    if args.interval <= 0:
        parser.error("--interval must be positive")
    return args


def main(argv: list[str]) -> int:
    args = parse_args(argv[1:])
    client = TurbohaulClient(args.manager_url, timeout_s=min(10.0, args.interval + 5.0))
    runtime = build_runtime(args, client)
    while True:
        try:
            hardware = probe_hardware()
            if not hardware.devices:
                raise RuntimeError("no supported accelerator inventory; refusing adaptive transition")
            controller = runtime.synchronize(args.selection, hardware)
            manager_status = client.status()
            current = controller.state.adaptive.current_index
            required = controller.requirements.required_mb_by_rung[current]
            pressure = probe_nvidia_pressure(
                hardware,
                manager_status=manager_status,
                managed_required_mb=required,
            )
            result = runtime.tick(pressure, now=time.monotonic())
            print(
                json.dumps(
                    {
                        "profile_id": result.state.profile_id,
                        "mode": result.state.selection_mode.value,
                        "rung_index": result.state.adaptive.current_index,
                        "action": result.action.value,
                        "transitioned": result.transitioned,
                        "reason": result.reason,
                    },
                    sort_keys=True,
                ),
                flush=True,
            )
        except Exception as exc:
            print(json.dumps({"error": str(exc)}, sort_keys=True), file=sys.stderr, flush=True)
            if args.once:
                return 1
        if args.once:
            return 0
        time.sleep(args.interval)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
