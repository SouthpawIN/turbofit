#!/usr/bin/env python3
"""Install the Turbofit v2 controller and continuous provider gateway."""
from __future__ import annotations

import argparse
import subprocess
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
UNIT_PATH = Path.home() / ".config" / "systemd" / "user" / "turbofit-controller.service"
GATEWAY_UNIT_PATH = UNIT_PATH.with_name("turbofit-gateway.service")


def unit_text() -> str:
    controller = ROOT / "scripts" / "turbofit-controller"
    return f"""[Unit]
Description=Turbofit native adaptive runtime controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={controller}
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/turbofit/controller.env

[Install]
WantedBy=default.target
"""


def gateway_unit_text() -> str:
    gateway = ROOT / "scripts" / "turbofit-gateway.py"
    return f"""[Unit]
Description=Turbofit provider gateway with campaign-safe API continuity
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart={gateway}
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=TURBOFIT_ALLOW_API=true
Environment=TURBOFIT_CAMPAIGN_LEASE=%h/.local/state/turbofit/campaign-lease.json

[Install]
WantedBy=default.target
"""


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--enable", action="store_true", help="enable for future user sessions")
    parser.add_argument("--start", action="store_true", help="start immediately after installing")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    content = unit_text()
    gateway_content = gateway_unit_text()
    if args.dry_run:
        print(content, end="")
        print("\n# turbofit-gateway.service")
        print(gateway_content, end="")
        return 0
    UNIT_PATH.parent.mkdir(parents=True, exist_ok=True)
    UNIT_PATH.write_text(content, encoding="utf-8")
    GATEWAY_UNIT_PATH.write_text(gateway_content, encoding="utf-8")
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    if args.enable or args.start:
        subprocess.run([
            "systemctl", "--user", "enable", "turbofit-controller.service", "turbofit-gateway.service",
        ], check=True)
    if args.start:
        subprocess.run([
            "systemctl", "--user", "restart", "turbofit-gateway.service", "turbofit-controller.service",
        ], check=True)
    print(UNIT_PATH)
    print(GATEWAY_UNIT_PATH)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
