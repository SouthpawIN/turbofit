#!/usr/bin/env bash
set -euo pipefail

manager=/home/sovthpaw/projects/turbohaul-manager-upstream/.venv/bin/turbohaul-manager
config=/home/sovthpaw/.config/turbohaul/turbofit-v2.yaml

# A package upgrade can replace userspace NVML/CUDA before the machine reloads
# the matching kernel module. Prefer the system stack when it works; otherwise
# bind this process and every llama.cpp child to the loaded module's compat libs.
if ! /usr/bin/nvidia-smi -L >/dev/null 2>&1; then
  kernel_version=$(sed -n 's/.*Kernel Module  \([0-9][0-9.]*\).*/\1/p' /proc/driver/nvidia/version | head -n 1)
  compat_dir="$HOME/.local/lib/nvidia-${kernel_version}/usr/lib/x86_64-linux-gnu"
  if [[ ! -d "$compat_dir" ]]; then
    echo "No NVIDIA userspace libraries match loaded kernel module ${kernel_version:-unknown}" >&2
    exit 1
  fi
  export LD_LIBRARY_PATH="$compat_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
else
  unset LD_LIBRARY_PATH
fi

exec "$manager" --config "$config" "$@"
