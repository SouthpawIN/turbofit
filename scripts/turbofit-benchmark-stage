#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
from pathlib import Path

from turbofit_runtime.benchmark_stage import BenchmarkSuite, run_benchmark


ROOT = Path(__file__).resolve().parents[1]


def main() -> int:
    parser = argparse.ArgumentParser(description="Run evidence-first local runtime benchmarks")
    parser.add_argument("--suite", default=str(ROOT / "benchmarks" / "stage-v1.json"))
    parser.add_argument("--base-url", default="http://127.0.0.1:8091/v1")
    parser.add_argument("--model", default="auto")
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--configuration", required=True)
    parser.add_argument("--output", required=True)
    parser.add_argument("--server-pid", type=int)
    parser.add_argument("--timeout", type=float, default=900.0)
    parser.add_argument("--api-key-env")
    parser.add_argument("--artifact-sha256")
    args = parser.parse_args()

    api_key = os.environ.get(args.api_key_env) if args.api_key_env else None
    if args.api_key_env and api_key is None:
        parser.error(f"environment variable is not set: {args.api_key_env}")

    result = run_benchmark(
        suite=BenchmarkSuite.load(args.suite),
        base_url=args.base_url,
        model=args.model,
        candidate=args.candidate,
        configuration=args.configuration,
        output_path=args.output,
        api_key=api_key,
        process_id=args.server_pid,
        timeout_seconds=args.timeout,
        artifact_sha256=args.artifact_sha256,
    )
    summary = result["summary"]
    print(
        f"status={result['status']} quality={summary['quality_pass_rate']} "
        f"context={summary['context_pass_rate']} "
        f"effective_output_tps={summary['effective_output_tokens_per_second']} "
        f"evidence={result['evidence_sha256']}"
    )
    return 0 if result["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
