#!/usr/bin/env python3
"""Run durable DeepSWE + agentic-pair intelligence benchmarks on production recipes."""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import subprocess
import sys
import threading
import time
import traceback
from dataclasses import asdict
from datetime import datetime, timezone
from pathlib import Path
from statistics import median
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "src"
if str(SRC) not in sys.path:
    sys.path.insert(0, str(SRC))

from turbofit_runtime.agentic_pair_benchmark import AgenticSuite, run_suite
from turbofit_runtime.backend import CampaignBackend
from turbofit_runtime.catalog_campaign import build_configuration_index
from turbofit_runtime.executor import (
    capture_physical_hardware, physical_evidence_current, production_recipe_sha256,
)
from turbofit_runtime.hardware import probe_hardware
from turbofit_runtime.intelligence import (
    BenchmarkMeasurement, ConfigurationIntelligence, canonical_intelligence_recipe,
    intelligence_score,
)
from turbofit_runtime.intelligence_campaign import (
    apply_deferred_configurations, build_state, complete_run, mark_running, next_ready_run, reconcile_state, recover_interrupted,
    refresh_runtime_status, retry_failed, summary,
)
from turbofit_runtime.model_catalog import ModelCatalog
from turbofit_runtime.recipes import RecipeBook
from turbofit_runtime.schema import MatrixRow

CONFIGURATIONS = ROOT / "references/configuration-matrix.json"
CATALOG = ROOT / "references/model-catalog.json"
RECIPES = ROOT / "references/model-recipes.json"
RUNTIME_STATE = ROOT / "references/catalog-campaign-state.json"
STATE = ROOT / "references/intelligence-campaign-state.json"
RESULTS = ROOT / "references/results/intelligence-campaign"
SCORES = ROOT / "references/intelligence-scores.json"
POLICY = ROOT / "references/catalog-campaign-policy.json"
AGENTIC_SUITE = ROOT / "references/benchmarks/agentic-pair-v1.json"
DEEPSWE = ROOT / "scripts/turbofit-deepswe"
DEEPSWE_ROOT = Path.home() / ".local/share/turbofit/benchmarks"
GATEWAY_PORT = 18092


def acquire_docker_gateway_rule(port: int) -> bool:
    """Temporarily admit PIER bridge traffic through a deny-incoming host firewall."""
    rule = ["INPUT", "-i", "br+", "-p", "tcp", "--dport", str(port), "-j", "ACCEPT"]
    present = subprocess.run(
        ["sudo", "-n", "iptables", "-C", *rule], capture_output=True, text=True,
    )
    if present.returncode == 0:
        return False
    subprocess.run(["sudo", "-n", "iptables", "-I", *rule], check=True)
    return True


def release_docker_gateway_rule(port: int, owned: bool) -> None:
    if not owned:
        return
    rule = ["INPUT", "-i", "br+", "-p", "tcp", "--dport", str(port), "-j", "ACCEPT"]
    subprocess.run(
        ["sudo", "-n", "iptables", "-D", *rule], capture_output=True, text=True, check=False,
    )


class RSSPeakSampler:
    """Sample aggregate resident memory for launched native components."""

    def __init__(self, pids: list[int], interval: float = 0.25) -> None:
        self.pids = pids
        self.interval = interval
        self.peak_mb = 0.0
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)

    @staticmethod
    def _rss_kib(pid: int) -> int:
        try:
            for line in Path(f"/proc/{pid}/status").read_text(encoding="utf-8").splitlines():
                if line.startswith("VmRSS:"):
                    return int(line.split()[1])
        except (OSError, ValueError, IndexError):
            return 0
        return 0

    def _run(self) -> None:
        while not self._stop.is_set():
            self.peak_mb = max(self.peak_mb, sum(self._rss_kib(pid) for pid in self.pids) / 1024)
            time.sleep(self.interval)

    def start(self) -> None:
        self._thread.start()

    def stop(self) -> None:
        self._stop.set()
        self._thread.join(timeout=2)


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.replace(temporary, path)


def load_inputs() -> tuple[dict[str, Any], ModelCatalog, RecipeBook, dict[str, dict[str, Any]], dict[str, str]]:
    configurations = json.loads(CONFIGURATIONS.read_text(encoding="utf-8"))
    catalog = ModelCatalog.load(CATALOG)
    recipes = RecipeBook.load(RECIPES, hardware=probe_hardware())
    index = build_configuration_index(configurations, catalog)
    by_model = {item.id: item for item in catalog.models}
    display_ids = {}
    for row in configurations["rows"]:
        main = by_model[row["main"]]
        aux = "auto" if row["auxiliary"] == "auto" else by_model[row["auxiliary"]].name
        display_ids[row["id"]] = MatrixRow.make_id(main.name, aux, int(row["context"]))
    return configurations, catalog, recipes, index, display_ids


def load_or_create_state(configurations: dict[str, Any]) -> dict[str, Any]:
    if STATE.exists():
        state = json.loads(STATE.read_text(encoding="utf-8"))
        expected = {f"{row['id']}::{level}" for row in configurations["rows"] for level in ("screening", "promotion", "release")}
        if set(state.get("runs", {})) != expected:
            state = reconcile_state(state, configurations)
            atomic_json(STATE, state)
        return state
    state = build_state(configurations)
    atomic_json(STATE, state)
    return state


def refresh(
    state: dict[str, Any], display_ids: dict[str, str], recipes: RecipeBook,
    configuration_index: dict[str, dict[str, Any]],
) -> None:
    try:
        policy = json.loads(POLICY.read_text(encoding="utf-8"))
    except FileNotFoundError:
        policy = {}
    deferred_models = frozenset(policy.get("deferred_models") or [])
    deferred_configurations = {
        run["configuration_id"]
        for run in state["runs"].values()
        if run["level"] == "screening"
        and (run["main"] in deferred_models or run["auxiliary"] in deferred_models)
    }
    apply_deferred_configurations(
        state, deferred_configurations,
        reason=str(policy.get("reason") or "deferred by catalog campaign policy"),
    )
    runtime = json.loads(RUNTIME_STATE.read_text(encoding="utf-8")) if RUNTIME_STATE.exists() else {"rows": {}}
    live_fingerprint = str(capture_physical_hardware()["fingerprint_sha256"])
    runtime = {
        **runtime,
        "rows": {
            row_id: (
                value
                if value.get("status") != "success" or physical_evidence_current(value, live_fingerprint)
                else {**value, "status": "pending"}
            )
            for row_id, value in (runtime.get("rows") or {}).items()
        },
    }
    expected = {}
    for configuration_id, display_id in display_ids.items():
        configuration = configuration_index[display_id]
        recipe = recipes.resolve_catalog_configuration(configuration)
        expected[configuration_id] = production_recipe_sha256(recipe, configuration)
    refresh_runtime_status(state, runtime, display_ids, expected)
    atomic_json(STATE, state)



def hardware_tier_gb() -> int:
    hardware = probe_hardware()
    capacity = round(hardware.total_usable_memory_mb / 1024) if hardware.shared_memory_pool else round(hardware.total_vram_mb / 1024)
    return max(tier for tier in (8, 16, 24, 48, 64, 96, 200, 300) if tier <= max(capacity, 8))


def _deepswe_aggregate(paths: list[Path]) -> tuple[BenchmarkMeasurement, dict[str, Any]]:
    payloads = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
    invalid = [item for item in payloads if item.get("status") != "measured" or item["summary"].get("infrastructure_failures", 0)]
    if invalid:
        raise RuntimeError(f"refusing {len(invalid)} invalid DeepSWE result set(s)")
    total = sum(item["summary"]["tasks_total"] for item in payloads)
    passed = sum(item["summary"]["tasks_passed"] for item in payloads)
    aggregate = {
        "schema": "turbofit.deepswe-aggregate/v1",
        "suite_revision": payloads[0]["suite"]["revision"],
        "tasks_total": total,
        "tasks_passed": passed,
        "score": passed / total,
        "runs": [{"path": str(path), "evidence_sha256": payload["evidence_sha256"]} for path, payload in zip(paths, payloads, strict=True)],
    }
    return BenchmarkMeasurement(
        name="deep-swe", revision=payloads[0]["suite"]["revision"], score=passed / total,
        tasks_total=total, tasks_passed=passed, raw_result="", raw_result_sha256="",
    ), aggregate


def _agentic_aggregate(paths: list[Path]) -> tuple[BenchmarkMeasurement, dict[str, Any], float]:
    payloads = [json.loads(path.read_text(encoding="utf-8")) for path in paths]
    case_total = sum(item["summary"]["tasks_total"] for item in payloads)
    aux_passed = sum(round(item["summary"]["aux_tool_accuracy"] * item["summary"]["tasks_total"]) for item in payloads)
    main_passed = sum(round(item["summary"]["main_synthesis_accuracy"] * item["summary"]["tasks_total"]) for item in payloads)
    decisions_total = 2 * case_total
    decisions_passed = aux_passed + main_passed
    speeds = []
    for payload in payloads:
        for case in payload["cases"]:
            for timings in (case.get("aux_timings") or {}, case.get("main_timings") or {}):
                speed = timings.get("predicted_per_second")
                if isinstance(speed, (int, float)) and speed > 0:
                    speeds.append(float(speed))
    if not speeds:
        raise RuntimeError("agentic benchmark returned no measured decode throughput")
    aggregate = {
        "schema": "turbofit.agentic-pair-aggregate/v1",
        "suite_revision": payloads[0]["suite"]["revision"],
        "tasks_total": case_total,
        "aux_passed": aux_passed,
        "main_passed": main_passed,
        "decisions_total": decisions_total,
        "decisions_passed": decisions_passed,
        "score": decisions_passed / decisions_total,
        "median_decode_tps": median(speeds),
        "runs": [{"path": str(path), "evidence_sha256": payload["evidence_sha256"]} for path, payload in zip(paths, payloads, strict=True)],
    }
    return BenchmarkMeasurement(
        name="agentic-pair", revision=payloads[0]["suite"]["revision"],
        score=decisions_passed / decisions_total, tasks_total=decisions_total,
        tasks_passed=decisions_passed, raw_result="", raw_result_sha256="",
    ), aggregate, float(median(speeds))


def benchmark_run(run: dict[str, Any], catalog: ModelCatalog, recipes: RecipeBook) -> Path:
    configurations = json.loads(CONFIGURATIONS.read_text(encoding="utf-8"))
    by_id = {row["id"]: row for row in configurations["rows"]}
    configuration = by_id[run["configuration_id"]]
    recipe = recipes.resolve_catalog_configuration(configuration)
    recipe_sha, recipe_payload = canonical_intelligence_recipe(configuration, recipe)
    result_dir = RESULTS / run["configuration_id"] / run["level"]
    result_dir.mkdir(parents=True, exist_ok=True)
    atomic_json(result_dir / "production-recipe.json", {"sha256": recipe_sha, **recipe_payload})
    attempt_id = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")
    attempt_dir = result_dir / "attempts" / attempt_id
    attempt_dir.mkdir(parents=True, exist_ok=False)
    atomic_json(attempt_dir / "production-recipe.json", {"sha256": recipe_sha, **recipe_payload})
    atomic_json(attempt_dir / "attempt.json", {
        "status": "running", "configuration_id": run["configuration_id"],
        "level": run["level"], "production_recipe_sha256": recipe_sha,
        "started_at": datetime.now(timezone.utc).isoformat(),
    })
    backend = CampaignBackend(
        gateway_script=ROOT / "scripts/turbofit-gateway.py",
        gateway_port=GATEWAY_PORT,
        result_dir=attempt_dir / "runtime",
        runtime_state=Path.home() / ".config/turbofit/intelligence-campaign-runtime-state.json",
    )
    started = []
    handles = {}
    rss_sampler = None
    firewall_rule_owned = False
    try:
        firewall_rule_owned = acquire_docker_gateway_rule(GATEWAY_PORT)
        for component in recipe.components:
            handle = backend.start(component)
            started.append((component, handle))
            handles[component.role] = handle
        checks = {component.role: backend.wait_ready(component, handle) for component, handle in started}
        rss_sampler = RSSPeakSampler([int(handle["pid"]) for _, handle in started if handle.get("pid")])
        rss_sampler.start()
        route = backend.route(recipe, handles)
        if route.get("main") != recipe.main_alias or route.get("aux") != recipe.aux_alias:
            raise RuntimeError(f"production route mismatch: {route}")
        deepswe_paths = []
        parameters = run["parameters"]
        dataset = DEEPSWE_ROOT / "deep-swe-435ee89ec2f2e2289f33b0da4f992f0b7b7266b9" / "tasks"
        if not dataset.is_dir():
            subprocess.run([str(DEEPSWE), "prepare", "--root", str(DEEPSWE_ROOT)], check=True)
        for repetition in range(parameters["deepswe_repetitions"]):
            jobs = attempt_dir / f"deepswe-jobs-{repetition}"
            output = attempt_dir / f"deepswe-{repetition}.json"
            command = [
                str(DEEPSWE), "run", "--dataset", str(dataset), "--model", "auto",
                "--base-url", f"http://127.0.0.1:{GATEWAY_PORT}/main/v1",
                "--jobs-dir", str(jobs), "--n-tasks", str(parameters["deepswe_tasks"]),
                "--sample-seed", str(repetition), "--configuration-id", run["configuration_id"],
                "--production-recipe-sha256", recipe_sha, "--summary-output", str(output),
            ]
            subprocess.run(command, check=True)
            deepswe_paths.append(output)
        suite = AgenticSuite.load(AGENTIC_SUITE)
        agentic_paths = []
        for repetition in range(parameters["agentic_repetitions"]):
            output = attempt_dir / f"agentic-pair-{repetition}.json"
            run_suite(
                suite=suite, gateway_base_url=f"http://127.0.0.1:{GATEWAY_PORT}",
                configuration_id=run["configuration_id"], main_model="auto", auxiliary_model="auto",
                production_recipe_sha256=recipe_sha, output_path=output,
            )
            agentic_paths.append(output)
        deep_measurement, deep_aggregate = _deepswe_aggregate(deepswe_paths)
        agent_measurement, agent_aggregate, throughput = _agentic_aggregate(agentic_paths)
        aggregate_path = attempt_dir / "raw-aggregate.json"
        aggregate = {
            "schema": "turbofit.intelligence-raw-aggregate/v1",
            "configuration_id": run["configuration_id"], "level": run["level"],
            "production_recipe_sha256": recipe_sha, "checks": checks, "route": route,
            "deep_swe": deep_aggregate, "agentic_pair": agent_aggregate,
            "gpu_peak_mb": backend.peak_gpu_mb(),
            "host_process_rss_peak_mb": rss_sampler.peak_mb,
            "docker_gateway_firewall": "temporary INPUT br+ tcp/18092 ACCEPT",
        }
        atomic_json(aggregate_path, aggregate)
        aggregate_sha = "sha256:" + hashlib.sha256(aggregate_path.read_bytes()).hexdigest()
        deep_measurement = BenchmarkMeasurement(**{**asdict(deep_measurement), "raw_result": str(aggregate_path), "raw_result_sha256": aggregate_sha})
        agent_measurement = BenchmarkMeasurement(**{**asdict(agent_measurement), "raw_result": str(aggregate_path), "raw_result_sha256": aggregate_sha})
        by_model = {item.id: item for item in catalog.models}
        quantizations = [by_model[configuration["main"]].quantization]
        quantizations.append("route-to-main" if configuration["auxiliary"] == "auto" else by_model[configuration["auxiliary"]].quantization)
        record = ConfigurationIntelligence(
            configuration_id=run["configuration_id"], hardware_tier_gb=hardware_tier_gb(),
            main=recipe.main_alias, auxiliary=recipe.aux_alias, context=int(configuration["context"]),
            quantizations=tuple(quantizations), production_recipe_sha256=recipe_sha,
            throughput_tps=throughput, measurements=(deep_measurement, agent_measurement),
        )
        payload = {
            "schema": "turbofit.configuration-intelligence/v1",
            **asdict(record),
            "intelligence_score": intelligence_score(record),
            "balanced_score": record.balanced,
            "benchmark_level": run["level"],
            "catalog_main": configuration["main"],
            "catalog_auxiliary": configuration["auxiliary"],
            "aux_mode": "shared-main" if configuration["auxiliary"] == "auto" else "dedicated",
            "recorded_at": datetime.now(timezone.utc).isoformat(),
            "host_process_rss_peak_mb": rss_sampler.peak_mb,
        }
        output = result_dir / "intelligence.json"
        atomic_json(output, payload)
        atomic_json(attempt_dir / "attempt.json", {
            "status": "success", "configuration_id": run["configuration_id"],
            "level": run["level"], "production_recipe_sha256": recipe_sha,
            "result": str(output), "recorded_at": datetime.now(timezone.utc).isoformat(),
        })
        return output
    except Exception as exc:
        failure = {
            "status": "failed", "configuration_id": run["configuration_id"],
            "level": run["level"], "production_recipe_sha256": recipe_sha,
            "exception_type": type(exc).__name__, "error": str(exc),
            "traceback": traceback.format_exc(),
            "recorded_at": datetime.now(timezone.utc).isoformat(),
        }
        atomic_json(attempt_dir / "failure.json", failure)
        atomic_json(attempt_dir / "attempt.json", failure)
        raise
    finally:
        if rss_sampler is not None:
            rss_sampler.stop()
        for component, handle in reversed(started):
            backend.stop(component, handle)
        release_docker_gateway_rule(GATEWAY_PORT, firewall_rule_owned)
        subprocess.run(["systemctl", "--user", "start", "turbofit-gateway.service"], capture_output=True, text=True)


def rebuild_scores(state: dict[str, Any]) -> None:
    records = []
    for run in state["runs"].values():
        if run["status"] == "success" and run.get("result"):
            path = Path(run["result"])
            if path.is_file():
                payload = json.loads(path.read_text(encoding="utf-8"))
                records.append(payload)
    atomic_json(SCORES, {
        "schema": "turbofit.intelligence-scores/v1",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "required_benchmarks": ["deep-swe", "agentic-pair"],
        "records": records,
    })


def run_one(state: dict[str, Any], catalog: ModelCatalog, recipes: RecipeBook) -> int:
    recover_interrupted(state)
    selected = next_ready_run(state)
    if selected is None:
        print(json.dumps({"status": "idle", **summary(state)}, indent=2))
        return 0
    run = mark_running(state, selected["id"])
    run["worker_pid"] = os.getpid()
    run["worker_boot_id"] = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="utf-8").strip()
    atomic_json(STATE, state)
    try:
        output = benchmark_run(run, catalog, recipes)
    except Exception as exc:
        complete_run(state, run["id"], result=None, error=f"{type(exc).__name__}: {exc}")
        atomic_json(STATE, state)
        print(json.dumps({"id": run["id"], "status": "failed", "error": str(exc)}, indent=2))
        return 1
    complete_run(state, run["id"], result=str(output))
    atomic_json(STATE, state)
    rebuild_scores(state)
    print(json.dumps({"id": run["id"], "status": "success", "result": str(output)}, indent=2))
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("init")
    sub.add_parser("status")
    sub.add_parser("run-one")
    run = sub.add_parser("run")
    run.add_argument("--limit", type=int, default=1)
    retry = sub.add_parser("retry-failed")
    retry.add_argument("--limit", type=int)
    args = parser.parse_args()
    configurations, catalog, recipes, configuration_index, display_ids = load_inputs()
    state = load_or_create_state(configurations)
    recover_interrupted(state)
    refresh(state, display_ids, recipes, configuration_index)
    if args.command == "init":
        print(json.dumps({"state": str(STATE), **summary(state)}, indent=2))
        return 0
    if args.command == "status":
        print(json.dumps(summary(state), indent=2))
        return 0
    if args.command == "retry-failed":
        selected = retry_failed(state, limit=args.limit)
        atomic_json(STATE, state)
        print(json.dumps({"requeued": len(selected), "runs": selected}, indent=2))
        return 0
    limit = 1 if args.command == "run-one" else args.limit
    failures = 0
    for _ in range(limit):
        failures += run_one(state, catalog, recipes)
        if next_ready_run(state) is None:
            break
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
